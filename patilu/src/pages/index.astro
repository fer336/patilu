---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCarousel from "../components/ProductCarousel.astro";
import { AVAILABILITY_LABELS, formatPrice, getPrimaryImage, getPublishedProducts, getTrendingProducts } from "../data/catalog";

const products = await getPublishedProducts();
const featured = products.slice(0, 4);
const featuredCarousel = featured.map((product) => ({
  slug: product.slug,
  title: product.title,
  price: formatPrice(product),
  availability: AVAILABILITY_LABELS[product.availability],
  image: getPrimaryImage(product),
}));
const trending = getTrendingProducts(products).slice(0, 3);

const principles = [
  ["Consulta clara", "Cada pedido se confirma con disponibilidad, precio y detalles antes de avanzar."],
  ["Hecho a mano", "Las piezas se trabajan punto por punto, con atención al acabado y al uso."],
  ["Diseño conversado", "Los encargos personalizados se evalúan según idea, colores, tamaño y referencias."],
];
---
<BaseLayout
  title="Muñecos tejidos al crochet en Pinamar | Patilu"
  description="Descubrí muñecos y amigurumis tejidos al crochet por Patilu en Pinamar. Diseños artesanales, encargos personalizados y consultas sin checkout."
  ogTitle="Patilu — Muñecos tejidos al crochet"
  ogDescription="Muñecos artesanales y diseños personalizados desde Pinamar."
  activePath="/"
>
  <section class="hero">
    <div class="container hero-stack">
      <div class="hero-copy">
        <p class="eyebrow">Nuevo catálogo <span aria-hidden="true">♡</span></p>
        <h1>Muñecos tejidos al crochet, <span>hechos con amor</span></h1>
        <p class="hero-text">Descubrí muñecos artesanales y amigurumis tejidos con dedicación. Elegí un diseño del catálogo o contá una idea personalizada.</p>
        <div class="hero-actions"><a class="button button-primary" href="/productos"><span aria-hidden="true">♡</span> Explorar catálogo</a><a class="button button-secondary" href="/personalizados"><span aria-hidden="true">☆</span> Pedido personalizado</a></div>
      </div>
      <div class="hero-portada">
        <img src="/assets/portada2.png" alt="Muñecos y amigurumis tejidos al crochet por Patilu, en madera junto a flores secas" width="1672" height="941" fetchpriority="high" />
        <span class="hero-badge">♡ Hecho a mano en Pinamar</span>
      </div>
      <p class="hero-proof">♡ Hecho a mano · Consulta previa · Personalizados · Diseños únicos</p>
    </div>
  </section>

  <section class="section products-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Catálogo artesanal</p><h2>Muñecos destacados <span aria-hidden="true">♡</span></h2></div><a class="text-link" href="/productos">Ver catálogo completo <span aria-hidden="true">→</span></a></div>
      <ProductCarousel products={featuredCarousel} />
    </div>
  </section>

  <section class="section trends-section">
    <div class="container trend-layout">
      <div class="trend-intro"><p class="eyebrow">Radar Patilu</p><h2>Tendencias</h2><p>Ideas de temporada para inspirar una consulta, siempre sujetas a revisión y posibilidad real de realización.</p><a class="text-link" href="/tendencias">Ver todas las tendencias →</a></div>
      {trending.length > 0
        ? <div class="trend-grid">{trending.map((product) => { const primary = getPrimaryImage(product); return <article class="trend-card">{primary && <img src={primary.url} alt={primary.alt_text} loading="lazy" />}<div><span class="badge badge-lavender">Inspiración</span><h3>{product.title}</h3><a href={`/productos/${product.slug}/`}>Consultar idea →</a></div></article>})}</div>
        : <p class="trend-empty">No hay tendencias publicadas por el momento. Muy pronto vas a poder consultar acá las últimas ideas de temporada.</p>}
    </div>
  </section>

  <section class="section custom-section">
    <div class="container custom-teaser">
      <div class="custom-copy"><p class="eyebrow">Creado especialmente para vos</p><h2>¿Tenés un personaje en mente? <span aria-hidden="true">♡</span></h2><p>También se pueden consultar muñecos personalizados. Contá tu idea y Patilu revisa tamaño, colores, detalles y referencias posibles antes de avanzar.</p><a class="button button-secondary" href="/personalizados">Contar mi idea ♡</a></div>
    </div>
  </section>

  <section class="section buying-section">
    <div class="container">
      <div class="how-card">
        <span class="how-ribbon">¿Cómo funciona?</span>
        <div class="how-grid">
          {[["1","Explorá el catálogo","Elegí tu muñeco favorito entre nuestros diseños."],["2","Consultá disponibilidad","Coordiná colores, detalles y tiempos de entrega."],["3","Hecho a mano con amor","Cada pedido se teje especialmente para vos."],["4","Coordinamos la entrega","Recibilo listo para enamorar y regalar."]].map(([n, h, p]) => <div class="how-step"><span class="how-num">{n}</span><h3>{h}</h3><p>{p}</p></div>)}
        </div>
        <a class="text-link how-link" href="/como-comprar">Ver el detalle completo <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section story-section">
    <div class="container story-grid">
      <img class="story-image" src="/assets/artesana.webp" alt="Manos tejiendo una pieza al crochet" loading="lazy" />
      <div class="story-copy"><p class="eyebrow">El corazón de Patilu</p><h2>Muñecos creados con tiempo y dedicación</h2><p>Patilu es un proyecto artesanal hecho en Pinamar. Cada muñeco está tejido a mano con dedicación, cuidado por los detalles e intención de acompañar historias cotidianas.</p><p class="location-note">♡ Hecho a mano en Pinamar, Argentina.</p><a class="text-link" href="/sobre-patilu">Conocé la historia completa →</a></div>
      <div class="testimonials"><div class="section-heading compact"><h2>Principios de consulta <span aria-hidden="true">♡</span></h2></div><div class="testimonial-grid">{principles.map(([h,p]) => <blockquote><p>{p}</p><footer>{h}</footer></blockquote>)}</div></div>
    </div>
  </section>

  <section class="section info-section">
    <div class="container info-grid">
      <div><p class="eyebrow">Coordinación</p><h2>Entregas y envíos a consultar</h2><p>Coordinación a confirmar según localidad y disponibilidad.</p><a class="text-link" href="/envios">Ver información de envíos →</a></div>
      <div><p class="eyebrow">Antes de pedir</p><h2>Preguntas frecuentes</h2><p>Resolvé las dudas más comunes antes de escribirnos.</p><a class="text-link" href="/preguntas-frecuentes">Ver preguntas frecuentes →</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .products-section,.buying-section,.info-section{background:var(--surface)}
  .badge{display:inline-flex;align-items:center;width:max-content;padding:5px 10px;border-radius:999px;font-size:.68rem;font-weight:800}.badge-lavender{background:#a78fc1;color:#fff}
  .hero{padding:56px 0 64px;text-align:center}.hero-stack{display:flex;flex-direction:column;align-items:center}.hero-copy{display:flex;flex-direction:column;align-items:center;gap:14px;max-width:640px;margin-inline:auto}.hero-text{font-size:1.08rem}.hero-actions{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:6px}
  .hero-portada{position:relative;width:100%;max-width:900px;margin:44px auto 24px;aspect-ratio:1672/941;overflow:hidden;border:var(--border-w) solid var(--text);border-radius:var(--radius-lg);box-shadow:var(--shadow-clay);animation:portada-in .6s cubic-bezier(.22,1,.36,1) both}.hero-portada img{width:100%;height:100%;object-fit:cover}.hero-badge{position:absolute;left:20px;bottom:20px;padding:9px 16px;border-radius:999px;background:rgba(255,253,249,.92);backdrop-filter:blur(6px);box-shadow:var(--shadow-sm);color:var(--primary-dark);font-size:.82rem;font-weight:800}.hero-proof{color:var(--muted);font-size:.82rem;font-weight:700}
  @keyframes portada-in{from{opacity:0;transform:translateY(22px) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
  @media (prefers-reduced-motion: reduce){.hero-portada{animation:none}}
  .trends-section{background:linear-gradient(180deg,#fff9f2 0%,#fffdf9 100%)}.trend-layout{display:grid;grid-template-columns:.72fr 2.28fr;gap:46px;align-items:center}.trend-intro p{max-width:300px}.trend-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.trend-card{display:grid;grid-template-columns:42% 58%;min-height:170px;overflow:hidden;border-radius:var(--radius-md);background:#fff;box-shadow:0 10px 26px rgba(70,56,58,.08);transition:transform .2s var(--ease-out),box-shadow .2s var(--ease-out)}.trend-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-clay)}.trend-card img{height:100%;object-fit:cover}.trend-card>div{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:16px}.trend-card h3{margin:11px 0 8px;font-size:1rem}.trend-card a{color:#d56879;font-size:.86rem;font-weight:800}.trend-empty{grid-column:2/-1;color:var(--muted)}
  .custom-section{background:radial-gradient(circle at 10% 20%,rgba(255,255,255,.55),transparent 25%),linear-gradient(135deg,#f6edf8 0%,#eee3f4 100%)}.custom-teaser{max-width:640px}.custom-copy p:not(.eyebrow){max-width:500px}
  .how-card{position:relative;margin-top:8px;padding:60px 32px 40px;border-radius:32px;background:#fff;box-shadow:var(--shadow-clay);text-align:center}.how-ribbon{position:absolute;top:-22px;left:50%;transform:translateX(-50%);padding:14px 36px 20px;background:var(--primary);color:#fff;font-family:"DM Serif Display",Georgia,serif;font-size:1.35rem;white-space:nowrap;clip-path:polygon(0 0,100% 0,100% 76%,92% 100%,50% 80%,8% 100%,0 76%)}.how-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;margin-top:8px}.how-step{display:flex;flex-direction:column;align-items:center;gap:10px}.how-num{width:56px;height:56px;display:grid;place-items:center;border-radius:50%;background:var(--primary);color:#fff;font-family:"DM Serif Display",Georgia,serif;font-size:1.3rem;box-shadow:0 10px 22px rgba(70,56,58,.15)}.how-step h3{font-size:1.02rem}.how-step p{margin:0;font-size:.88rem}.how-link{display:inline-block;margin-top:30px}
  .story-section{background:linear-gradient(180deg,#fdf1e7 0%,#fffaf4 100%)}.story-grid{display:grid;grid-template-columns:.65fr .8fr 1.55fr;gap:34px;align-items:stretch}.story-image{height:100%;min-height:360px;border:var(--border-w) solid var(--text);border-radius:var(--radius-lg);object-fit:cover;box-shadow:var(--shadow-clay)}.story-copy{display:flex;flex-direction:column;justify-content:center;gap:6px}.location-note{color:var(--primary-dark);font-weight:800}.testimonials{align-self:center}.testimonial-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}blockquote{margin:0;padding:20px;border:var(--border-w) solid var(--text);border-radius:var(--radius-md);background:var(--surface);box-shadow:var(--shadow-clay)}blockquote p{font-size:.86rem}blockquote footer{font-size:.75rem;font-weight:800}
  .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.info-grid>div{padding:28px;border:var(--border-w) solid var(--text);border-radius:var(--radius-lg);background:#fff;box-shadow:var(--shadow-clay)}
  @media (max-width:1100px){.story-grid{grid-template-columns:.7fr 1.3fr}.testimonials{grid-column:1/-1}}
  @media (max-width:900px){.trend-layout,.info-grid,.how-grid{grid-template-columns:1fr}.how-grid{gap:26px}.story-grid{grid-template-columns:.85fr 1.15fr}.testimonial-grid{grid-template-columns:1fr 1fr 1fr}}
  @media (max-width:680px){h1{font-size:clamp(2.5rem,12vw,4rem)}.hero{padding:36px 0 48px}.hero-actions .button{width:100%}.hero-portada{margin:28px auto 18px;border-radius:var(--radius-md)}.hero-badge{left:12px;bottom:12px;padding:7px 13px;font-size:.72rem}.hero-proof{font-size:.74rem;line-height:1.6}.trend-grid{grid-template-columns:1fr}.trend-card{min-height:150px}.story-grid{grid-template-columns:1fr}.story-image{min-height:320px}.testimonial-grid{grid-template-columns:1fr}.info-grid{grid-template-columns:1fr}}
</style>
