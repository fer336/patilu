---
import BaseLayout from "../layouts/BaseLayout.astro";
import { AVAILABILITY_LABELS, formatPrice, getPrimaryImage, getPublishedProducts, getTrendingProducts } from "../data/catalog";
import { getProductWhatsappUrl } from "../data/products";

const products = await getPublishedProducts();
const featured = products.slice(0, 4);
const trending = getTrendingProducts(products).slice(0, 3);

const principles = [
  ["Consulta clara", "Cada pedido se confirma con disponibilidad, precio y detalles antes de avanzar."],
  ["Hecho a mano", "Las piezas se trabajan punto por punto, con atención al acabado y al uso."],
  ["Diseño conversado", "Los encargos personalizados se evalúan según idea, colores, tamaño y referencias."],
];
---
<BaseLayout
  title="Muñecos tejidos al crochet en Pinamar | Patilu"
  description="Descubrí muñecos y amigurumis tejidos al crochet por Patilu en Pinamar. Diseños artesanales, encargos personalizados y consultas sin checkout."
  ogTitle="Patilu — Muñecos tejidos al crochet"
  ogDescription="Muñecos artesanales y diseños personalizados desde Pinamar."
  activePath="/"
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Muñecos artesanales desde Pinamar</p>
        <h1>Muñecos tejidos al crochet hechos a mano en Pinamar <span aria-hidden="true">♡</span></h1>
        <p class="hero-text">Descubrí muñecos artesanales y amigurumis tejidos con dedicación. Elegí un diseño del catálogo o contá una idea personalizada. La disponibilidad, el precio y la coordinación se consultan antes de confirmar.</p>
        <div class="hero-actions"><a class="button button-primary" href="/productos">Consulta de catálogo <span aria-hidden="true">→</span></a><a class="button button-secondary" href="/personalizados">Pedido personalizado <span aria-hidden="true">♡</span></a></div>
        <ul class="trust-list" aria-label="Características"><li><span aria-hidden="true">🧶</span> Hecho a mano</li><li><span aria-hidden="true">⌁</span> Consulta previa</li><li><span aria-hidden="true">☆</span> Personalizados</li></ul>
      </div>
      <div class="hero-visual"><img src="/assets/muneca.webp" alt="Muñeca artesanal tejida al crochet" /><div class="hero-note"><strong>Diseños únicos</strong><span>Tejidos punto por punto</span></div></div>
    </div>
  </section>

  <section class="section products-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Catálogo artesanal</p><h2>Muñecos destacados <span aria-hidden="true">♡</span></h2></div><a class="text-link" href="/productos">Ver catálogo completo <span aria-hidden="true">→</span></a></div>
      <div class="product-grid">
        {featured.map((product) => { const primary = getPrimaryImage(product); return <article class="product-card"><div class="product-image">{primary ? <img src={primary.url} alt={primary.alt_text} loading="lazy" /> : <div class="catalog-placeholder">Foto próximamente</div>}</div><div class="product-body"><h3>{product.title}</h3><p class="price">{formatPrice(product)}</p><p class="stock">{AVAILABILITY_LABELS[product.availability]}</p><div class="product-actions"><a class="button button-outline" href={getProductWhatsappUrl({ name: product.title })} target="_blank" rel="noopener noreferrer">Consultar</a><a class="button button-soft" href={`/productos/${product.slug}/`}>Ver</a><button class="button button-primary" type="button" data-buy-button data-product={product.title}>Comprar</button></div></div></article>})}
      </div>
    </div>
  </section>

  <section class="section trends-section">
    <div class="container trend-layout">
      <div class="trend-intro"><p class="eyebrow">Radar Patilu</p><h2>Tendencias</h2><p>Ideas de temporada para inspirar una consulta, siempre sujetas a revisión y posibilidad real de realización.</p><a class="text-link" href="/tendencias">Ver todas las tendencias →</a></div>
      {trending.length > 0
        ? <div class="trend-grid">{trending.map((product) => { const primary = getPrimaryImage(product); return <article class="trend-card">{primary && <img src={primary.url} alt={primary.alt_text} loading="lazy" />}<div><span class="badge badge-lavender">Inspiración</span><h3>{product.title}</h3><a href={`/productos/${product.slug}/`}>Consultar idea →</a></div></article>})}</div>
        : <p class="trend-empty">No hay tendencias publicadas por el momento. Muy pronto vas a poder consultar acá las últimas ideas de temporada.</p>}
    </div>
  </section>

  <section class="section custom-section">
    <div class="container custom-teaser">
      <div class="custom-copy"><p class="eyebrow">Creado especialmente para vos</p><h2>¿Tenés un personaje en mente? <span aria-hidden="true">♡</span></h2><p>También se pueden consultar muñecos personalizados. Contá tu idea y Patilu revisa tamaño, colores, detalles y referencias posibles antes de avanzar.</p><a class="button button-secondary" href="/personalizados">Contar mi idea ♡</a></div>
    </div>
  </section>

  <section class="section buying-section">
    <div class="container buying-grid"><div class="buying-title"><p class="eyebrow">Simple y directo</p><h2>¿Cómo consultar?</h2><a class="text-link" href="/como-comprar">Ver el detalle completo →</a></div>{[["1","Elegí tu muñeco","Explorá el catálogo y marcá el diseño que te interesa."],["2","Contanos tu consulta","Pedí precio, disponibilidad, colores o variantes."],["3","Coordinamos los datos","Patilu confirma posibilidades y forma de entrega o envío."]].map(([n,h,p],i) => <article class="step-card"><div class={`step-icon ${["step-pink","step-purple","step-green"][i]}`}>{n}</div><div><h3>{h}</h3><p>{p}</p></div></article>)}</div>
  </section>

  <section class="section story-section">
    <div class="container story-grid">
      <img class="story-image" src="/assets/artesana.webp" alt="Manos tejiendo una pieza al crochet" loading="lazy" />
      <div class="story-copy"><p class="eyebrow">El corazón de Patilu</p><h2>Muñecos creados con tiempo y dedicación</h2><p>Patilu es un proyecto artesanal hecho en Pinamar. Cada muñeco está tejido a mano con dedicación, cuidado por los detalles e intención de acompañar historias cotidianas.</p><p class="location-note">♡ Hecho a mano en Pinamar, Argentina.</p><a class="text-link" href="/sobre-patilu">Conocé la historia completa →</a></div>
      <div class="testimonials"><div class="section-heading compact"><h2>Principios de consulta <span aria-hidden="true">♡</span></h2></div><div class="testimonial-grid">{principles.map(([h,p]) => <blockquote><p>{p}</p><footer>{h}</footer></blockquote>)}</div></div>
    </div>
  </section>

  <section class="section info-section">
    <div class="container info-grid">
      <div><p class="eyebrow">Coordinación</p><h2>Entregas y envíos a consultar</h2><p>Coordinación a confirmar según localidad y disponibilidad.</p><a class="text-link" href="/envios">Ver información de envíos →</a></div>
      <div><p class="eyebrow">Antes de pedir</p><h2>Preguntas frecuentes</h2><p>Resolvé las dudas más comunes antes de escribirnos.</p><a class="text-link" href="/preguntas-frecuentes">Ver preguntas frecuentes →</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .products-section,.buying-section,.info-section{background:var(--surface)}.product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}.product-card{overflow:hidden;border:1px solid var(--border);border-radius:20px;background:#fff;box-shadow:0 8px 24px rgba(70,56,58,.055);transition:transform .2s ease,box-shadow .2s ease}.product-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-sm)}.product-image{position:relative;aspect-ratio:1/1.12;overflow:hidden;background:#f8eee6}.product-image img{height:100%;object-fit:contain;transition:transform .35s ease}.product-card:hover .product-image img{transform:scale(1.035)}.product-body{padding:15px}.product-body h3{min-height:38px;font-size:1rem}.price{margin-bottom:6px;color:#d26073;font-size:.95rem;font-weight:800}.stock{margin-bottom:14px;color:#6b5d60;font-size:.78rem;font-weight:800}.product-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.product-actions .button{width:100%;min-height:40px;padding:9px 10px;border-radius:12px;font-size:.82rem}.product-actions .button-primary{grid-column:1/-1}.catalog-placeholder{height:100%;display:grid;place-items:center;padding:20px;color:var(--muted);font-size:.8rem;text-align:center}
  .badge{display:inline-flex;align-items:center;width:max-content;padding:5px 9px;border-radius:999px;font-size:.68rem;font-weight:800}.badge-lavender{background:#a78fc1;color:#fff}
  .hero{position:relative;overflow:hidden;padding:62px 0 40px;background:radial-gradient(circle at 14% 20%,rgba(244,221,164,.24),transparent 26%),radial-gradient(circle at 85% 10%,rgba(207,196,232,.3),transparent 28%),linear-gradient(180deg,#fffdf9 0%,#fff8f0 100%)}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:52px}.hero-text{max-width:630px;margin-bottom:28px;font-size:1.08rem}.hero-actions,.trust-list{display:flex;flex-wrap:wrap;gap:12px}.trust-list{gap:10px;margin:28px 0 0;padding:0;list-style:none}.trust-list li{display:flex;align-items:center;gap:8px;padding:10px 13px;border:1px solid var(--border);border-radius:13px;background:rgba(255,255,255,.72);box-shadow:0 5px 16px rgba(70,56,58,.04);font-size:.92rem;font-weight:700}.hero-visual{position:relative;width:min(100%,390px);aspect-ratio:4/5;justify-self:end;overflow:hidden;border:1px solid rgba(232,220,221,.8);border-radius:32px;background:#f8eee6;box-shadow:var(--shadow)}.hero-visual img{height:100%;object-fit:contain;object-position:center}.hero-note{position:absolute;z-index:2;right:18px;bottom:18px;display:flex;flex-direction:column;padding:13px 16px;border:1px solid rgba(255,255,255,.7);border-radius:16px;background:rgba(255,253,249,.86);box-shadow:var(--shadow-sm);backdrop-filter:blur(10px)}.hero-note span{color:var(--muted);font-size:.86rem}
  .trends-section{background:linear-gradient(180deg,#fff9f2 0%,#fffdf9 100%)}.trend-layout{display:grid;grid-template-columns:.72fr 2.28fr;gap:46px;align-items:center}.trend-intro p{max-width:300px}.trend-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.trend-card{display:grid;grid-template-columns:42% 58%;min-height:170px;overflow:hidden;border:1px solid var(--border);border-radius:20px;background:#fff;box-shadow:var(--shadow-sm)}.trend-card img{height:100%;object-fit:cover}.trend-card>div{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:16px}.trend-card h3{margin:11px 0 8px;font-size:1rem}.trend-card a{color:#d56879;font-size:.86rem;font-weight:800}.trend-empty{grid-column:2/-1;color:var(--muted)}
  .custom-section{background:radial-gradient(circle at 10% 20%,rgba(255,255,255,.55),transparent 25%),linear-gradient(135deg,#f6edf8 0%,#eee3f4 100%)}.custom-teaser{max-width:640px}.custom-copy p:not(.eyebrow){max-width:500px}
  .buying-grid{display:grid;grid-template-columns:.9fr repeat(3,1fr);gap:28px;align-items:center}.buying-title{display:flex;flex-direction:column;gap:10px}.step-card{display:grid;grid-template-columns:54px 1fr;gap:14px;align-items:center}.step-card p{margin:0;font-size:.9rem}.step-icon{width:54px;height:54px;display:grid;place-items:center;border-radius:50%;font-weight:900}.step-pink{border:2px solid #eba7b2;color:#da7182;background:#fff4f5}.step-purple{border:2px solid #bba8d1;color:#8c70ab;background:#f7f1fb}.step-green{border:2px solid #aac99f;color:#668c5d;background:#f5faf2}
  .story-section{background:linear-gradient(180deg,#fdf1e7 0%,#fffaf4 100%)}.story-grid{display:grid;grid-template-columns:.65fr .8fr 1.55fr;gap:34px;align-items:stretch}.story-image{height:100%;min-height:360px;border-radius:24px;object-fit:cover;box-shadow:var(--shadow-sm)}.story-copy{display:flex;flex-direction:column;justify-content:center;gap:6px}.location-note{color:var(--primary-dark);font-weight:800}.testimonials{align-self:center}.testimonial-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}blockquote{margin:0;padding:20px;border:1px solid var(--border);border-radius:18px;background:rgba(255,255,255,.82)}blockquote p{font-size:.86rem}blockquote footer{font-size:.75rem;font-weight:800}
  .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}.info-grid>div{padding:28px;border:1px solid var(--border);border-radius:20px;background:#fff}
  @media (max-width:1100px){.product-grid{grid-template-columns:repeat(2,1fr)}.story-grid{grid-template-columns:.7fr 1.3fr}.testimonials{grid-column:1/-1}}
  @media (max-width:900px){.hero-grid,.trend-layout,.info-grid{grid-template-columns:1fr}.hero-visual{width:min(100%,360px);justify-self:center}.buying-grid{grid-template-columns:1fr 1fr}.story-grid{grid-template-columns:.85fr 1.15fr}.testimonial-grid{grid-template-columns:1fr 1fr 1fr}}
  @media (max-width:680px){h1{font-size:clamp(2.5rem,12vw,4rem)}.hero{padding-top:34px}.hero-grid{gap:30px}.hero-visual{width:min(100%,280px)}.hero-actions .button{width:100%}.product-grid{grid-template-columns:repeat(2,1fr)}.trend-grid{grid-template-columns:1fr}.trend-card{min-height:150px}.buying-grid{grid-template-columns:1fr}.story-grid{grid-template-columns:1fr}.story-image{min-height:320px}.testimonial-grid{grid-template-columns:1fr}.info-grid{grid-template-columns:1fr}}
  @media (max-width:420px){.product-grid{grid-template-columns:1fr}}
</style>
