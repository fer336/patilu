# Patilu foundation environment template.
# Copy to .env locally and fill only with real values from the operator.

# Shared public configuration
PATILU_PUBLIC_SITE_URL=
PATILU_PUBLIC_API_URL=
PATILU_PUBLIC_CMS_URL=
PATILU_WHATSAPP_NUMBER=
PATILU_INSTAGRAM_URL=

# API runtime
PATILU_ENV=development
PATILU_DATABASE_URL=postgresql://patilu:patilu@localhost:5432/patilu
PATILU_ALLOWED_ORIGINS=http://localhost:4321,http://localhost:5173
PATILU_SESSION_SECRET=
PATILU_REBUILD_WEBHOOK_SECRET=

# Object storage placeholders for the later MinIO slice
PATILU_MINIO_ENDPOINT=http://localhost:9000
PATILU_MINIO_BUCKET=patilu-media
PATILU_MINIO_ACCESS_KEY=
PATILU_MINIO_SECRET_KEY=
