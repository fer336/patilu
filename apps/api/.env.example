# Database
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/patilu

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MinIO / S3
S3_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
S3_BUCKET=patilu-productos
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000/patilu-productos

# Legacy admin token fallback for CMS API access
API_ADMIN_TOKEN=change-me

# Backend-only token for external AI agent gallery APIs
API_AGENT_TOKEN=optional-legacy-agent-token
