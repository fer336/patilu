---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---
<BaseLayout
  title="Privacidad | Patilu"
  description="Política de privacidad de Patilu."
  activePath="/privacidad"
>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Privacidad" }]} />
  <section class="section legal-section">
    <div class="container">
      <p class="eyebrow">Legal</p>
      <h1>Privacidad</h1>
      <p>Política de privacidad próximamente. Ante cualquier duda sobre el uso de tus datos, podés consultar directamente por WhatsApp.</p>
      <a class="text-link" href="/contacto">Ir a contacto →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-section{background:var(--surface)}.legal-section p{max-width:60ch}
</style>
