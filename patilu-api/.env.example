# Local development values. In production the API does not receive these as
# individual environment variables: it loads the bundled Docker Swarm secret
# patilu_backend_env, mounted at /run/secrets/backend.env, which contains this
# same dotenv document (DATABASE_URL, MINIO_ACCESS_KEY, MINIO_SECRET_KEY,
# API_ADMIN_TOKEN, and any other secret setting).
DATABASE_URL=postgresql+psycopg://patilu:replace-me@localhost:5432/patilu
CORS_ORIGINS=["http://localhost:5173"]
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=product-images
MINIO_SECURE=false
MEDIA_PUBLIC_URL=http://localhost:9000/product-images
