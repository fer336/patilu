---
const { id = "purchase-modal" } = Astro.props;
---

<div class="purchase-modal" id={id} data-purchase-modal hidden>
  <div class="modal-backdrop" data-modal-close></div>
  <section class="modal-panel" role="dialog" aria-modal="true" aria-labelledby={`${id}-title`} tabindex="-1">
    <button class="modal-close" type="button" aria-label="Cerrar consulta de compra" data-modal-close>×</button>
    <p class="eyebrow">Compra a coordinar</p>
    <h2 id={`${id}-title`}>Dejanos tus datos</h2>
    <p>Patilu va a usar estos datos para continuar la compra y confirmar precio, disponibilidad y coordinación. No se realiza ningún pago todavía.</p>
    <form class="purchase-form" novalidate>
      <input type="hidden" name="product" value="" data-product-input />
      <label>
        <span>Celular</span>
        <input type="tel" name="phone" autocomplete="tel" required inputmode="tel" placeholder="Ej: 2254 531588" />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" required placeholder="tu@email.com" />
      </label>
      <button class="button button-primary" type="submit">Enviar datos</button>
      <p class="form-status" role="status" aria-live="polite">Completá celular y email para dejar preparada la consulta.</p>
    </form>
  </section>
</div>

<style is:global>
  body.modal-open{overflow:hidden}.purchase-modal[hidden]{display:none}.purchase-modal{position:fixed;z-index:500;inset:0;display:grid;place-items:center;padding:20px}.modal-backdrop{position:absolute;inset:0;background:rgba(70,56,58,.46);backdrop-filter:blur(6px)}.modal-panel{position:relative;width:min(100%,460px);padding:28px;border:1px solid rgba(255,255,255,.72);border-radius:24px;background:var(--surface,#fffdf9);box-shadow:0 24px 70px rgba(70,56,58,.26)}.modal-panel h2{margin-bottom:10px}.modal-close{position:absolute;top:14px;right:14px;width:42px;height:42px;border:1px solid var(--border,#e8dcdd);border-radius:50%;background:#fff;color:var(--text,#46383a);cursor:pointer;font-size:1.4rem;font-weight:800}.purchase-form{display:grid;gap:14px;margin-top:20px}.purchase-form label span{display:block;margin-bottom:5px;font-size:.78rem;font-weight:900}.purchase-form input{width:100%;padding:12px 13px;border:1px solid var(--border,#e8dcdd);border-radius:12px;background:#fff;color:var(--text,#46383a)}.purchase-form .button{width:100%}@media (max-width:520px){.modal-panel{padding:24px 18px;border-radius:20px}}
</style>

<script is:inline>
  const modal = document.querySelector("[data-purchase-modal]");
  const panel = modal?.querySelector(".modal-panel");
  const productInput = modal?.querySelector("[data-product-input]");
  const modalStatus = modal?.querySelector(".form-status");
  let previousFocus = null;

  const closePurchaseModal = () => {
    if (!modal || modal.hasAttribute("hidden")) return;
    modal.setAttribute("hidden", "");
    document.body.classList.remove("modal-open");
    previousFocus?.focus?.();
  };

  const openPurchaseModal = (product) => {
    if (!modal) return;
    previousFocus = document.activeElement;
    productInput.value = product || "Consulta de producto";
    modal.removeAttribute("hidden");
    document.body.classList.add("modal-open");
    modalStatus.textContent = product ? `Completá tus datos para consultar la compra de ${product}.` : "Completá celular y email para dejar preparada la consulta.";
    panel?.focus();
  };

  document.querySelectorAll("[data-buy-button]").forEach((button) => {
    button.addEventListener("click", () => openPurchaseModal(button.dataset.product));
  });
  modal?.querySelectorAll("[data-modal-close]").forEach((element) => element.addEventListener("click", closePurchaseModal));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closePurchaseModal();
  });
  modal?.querySelector("form")?.addEventListener("submit", (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    if (!form.checkValidity()) {
      form.reportValidity();
      modalStatus.textContent = "Revisá los campos marcados: necesitamos celular y email para continuar.";
      return;
    }
    const product = new FormData(form).get("product") || "tu consulta";
    modalStatus.textContent = `Gracias. Dejamos preparados tus datos para ${product}; Patilu va a coordinar el siguiente paso más adelante.`;
    form.reset();
  });
</script>
