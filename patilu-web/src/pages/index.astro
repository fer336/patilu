---
const products = [
  ["¡Más elegido!", "badge-pink", "/assets/osito.webp", "Osito tejido", "Osito tejido al crochet color beige"],
  ["Nuevo", "badge-green", "/assets/capibara.webp", "Capibara crochet", "Capibara tejida al crochet"],
  ["", "", "/assets/conejita.webp", "Conejita pastel", "Conejita pastel tejida al crochet"],
  ["", "", "/assets/ballenita.webp", "Ballenita", "Ballenita celeste tejida al crochet"],
  ["Nuevo", "badge-green", "/assets/muneca-floral.webp", "Muñeca floral", "Muñeca floral tejida al crochet"],
  ["", "", "/assets/unicornio.webp", "Unicornio mini", "Unicornio mini tejido al crochet"],
];
const trends = [
  ["/assets/tendencia-hortensia.webp", "Muñeca Hortensia", "Muñeca Hortensia tejida al crochet"],
  ["/assets/tendencia-dino.webp", "Dino pastel", "Dinosaurio pastel tejido al crochet"],
  ["/assets/tendencia-abeja.webp", "Abejita dulce", "Abejita dulce tejida al crochet"],
];
const principles = [
  ["Consulta clara", "Cada pedido se confirma con disponibilidad, precio y detalles antes de avanzar."],
  ["Hecho a mano", "Las piezas se trabajan punto por punto, con atención al acabado y al uso."],
  ["Diseño conversado", "Los encargos personalizados se evalúan según idea, colores, tamaño y referencias."],
];
const faqs = [
  ["¿Cuánto tarda en estar listo mi pedido?", "Los tiempos dependen de disponibilidad, tamaño y complejidad. Patilu los confirma en la consulta."],
  ["¿Hacen envíos?", "Se puede consultar por opciones de envío y entrega antes de confirmar el pedido."],
  ["¿Puedo pedir un muñeco personalizado?", "Sí. Podés contar tu idea y Patilu te indica si es posible realizarla y qué datos faltan."],
];
const nav = [["inicio","Inicio"],["munecos","Muñecos"],["tendencias","Tendencias"],["personalizados","Personalizados"],["sobre-patilu","Sobre Patilu"],["contacto","Contacto"]];
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Muñecos tejidos al crochet en Pinamar | Patilu</title>
    <meta name="description" content="Descubrí muñecos y amigurumis tejidos al crochet por Patilu en Pinamar. Diseños artesanales, encargos personalizados y consultas sin checkout." />
    <meta name="theme-color" content="#fff9f2" />
    <meta property="og:title" content="Patilu — Muñecos tejidos al crochet" />
    <meta property="og:description" content="Muñecos artesanales y diseños personalizados desde Pinamar." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header" id="inicio">
      <div class="container nav-wrap">
        <a class="brand" href="#inicio" aria-label="Patilu, volver al inicio">
          <svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><circle cx="27" cy="31" r="17" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M13 24c12 3 25 10 34 24M14 38c11-9 23-15 36-15M22 15c4 12 12 25 22 35M13 31c11-4 24-7 38-4M21 49c10-10 17-22 20-35" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M45 42c8-3 12 2 10 7-2 5-8 6-12 2-4-4-2-8 2-9Z" fill="none" stroke="currentColor" stroke-width="2"/></svg>
          <span>Patilu</span>
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><span></span><span></span><span></span><span class="sr-only">Abrir menú</span></button>
        <nav id="main-nav" class="main-nav" aria-label="Navegación principal">{nav.map(([id,label]) => <a class={id === "inicio" ? "active" : ""} href={`#${id}`}>{label}</a>)}</nav>
        <a class="button button-whatsapp nav-cta" href="#contacto"><span aria-hidden="true">◉</span> Consultar contacto</a>
      </div>
    </header>

    <main id="contenido">
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Muñecos artesanales desde Pinamar</p>
            <h1>Muñecos tejidos al crochet hechos a mano en Pinamar <span aria-hidden="true">♡</span></h1>
            <p class="hero-text">Descubrí muñecos artesanales y amigurumis tejidos con dedicación. Elegí un diseño del catálogo o contá una idea personalizada. La disponibilidad, el precio y la coordinación se consultan antes de confirmar.</p>
            <div class="hero-actions"><a class="button button-primary" href="#munecos">Consulta de catálogo <span aria-hidden="true">→</span></a><a class="button button-secondary" href="#personalizados">Pedido personalizado <span aria-hidden="true">♡</span></a></div>
            <ul class="trust-list" aria-label="Características"><li><span aria-hidden="true">🧶</span> Hecho a mano</li><li><span aria-hidden="true">⌁</span> Consulta previa</li><li><span aria-hidden="true">☆</span> Personalizados</li></ul>
          </div>
          <div class="hero-visual"><img src="/assets/hero.webp" alt="Colección de muñecos artesanales tejidos al crochet" /><div class="hero-note"><strong>Diseños únicos</strong><span>Tejidos punto por punto</span></div></div>
        </div>
      </section>

      <section class="section products-section" id="munecos">
        <div class="container">
          <div class="section-heading"><div><p class="eyebrow">Catálogo artesanal</p><h2>Muñecos destacados <span aria-hidden="true">♡</span></h2></div><a class="text-link" href="#catalogo">Ver consulta de catálogo <span aria-hidden="true">→</span></a></div>
          <div class="product-grid" id="catalogo">
            {products.map(([badge, badgeClass, image, name, alt]) => <article class="product-card"><div class="product-image">{badge && <span class={`badge ${badgeClass}`}>{badge}</span>}<img src={image} alt={alt} loading="lazy" /></div><div class="product-body"><h3>{name}</h3><p class="price">Consultar precio</p><p class="stock">Consultá disponibilidad</p><a class="button button-outline" href="#contacto">Consultar este muñeco</a></div></article>)}
          </div>
        </div>
      </section>

      <section class="section trends-section" id="tendencias">
        <div class="container trend-layout">
          <div class="trend-intro"><p class="eyebrow">Radar Patilu</p><h2>Tendencias</h2><p>Ideas de temporada para inspirar una consulta, siempre sujetas a revisión y posibilidad real de realización.</p><a class="text-link" href="#personalizados">Pedir inspiración personalizada →</a></div>
          <div class="trend-grid">{trends.map(([image,name,alt]) => <article class="trend-card"><img src={image} alt={alt} loading="lazy" /><div><span class="badge badge-lavender">Inspiración</span><h3>{name}</h3><a href="#personalizados">Consultar idea →</a></div></article>)}</div>
        </div>
      </section>

      <section class="section custom-section" id="personalizados">
        <div class="container custom-grid">
          <div class="custom-copy"><p class="eyebrow">Creado especialmente para vos</p><h2>¿Tenés un personaje en mente? <span aria-hidden="true">♡</span></h2><p>También se pueden consultar muñecos personalizados. Contá tu idea y Patilu revisa tamaño, colores, detalles y referencias posibles antes de avanzar.</p><a class="button button-secondary" href="#custom-form">Contar mi idea ♡</a></div>
          <div class="custom-process" aria-label="Proceso de diseño personalizado">
            <div class="idea-card"><span class="step-label">1. Tu idea</span><div class="sketch" aria-hidden="true"><span>♡</span><div class="sketch-head"></div><div class="sketch-body"></div></div></div><span class="process-arrow" aria-hidden="true">→</span>
            <div class="idea-card"><span class="step-label">2. Nos inspiramos</span><img src="/assets/personalizado.webp" alt="Ejemplo de muñeca personalizada tejida al crochet" loading="lazy" /></div><span class="process-arrow" aria-hidden="true">→</span>
            <form class="mini-form" id="custom-form" novalidate><strong>3. Contanos tu idea</strong><label><span>Nombre</span><input type="text" name="name" autocomplete="name" required placeholder="Tu nombre" /></label><label><span>Idea</span><textarea name="idea" rows="3" required minlength="12" placeholder="Personaje, colores, tamaño..."></textarea></label><button class="button button-primary" type="submit">Revisar consulta</button><p class="form-status" role="status" aria-live="polite">Completá el formulario para preparar tu consulta. No se abrirá WhatsApp hasta confirmar un contacto real.</p></form>
          </div>
        </div>
      </section>

      <section class="section buying-section">
        <div class="container buying-grid"><div class="buying-title"><p class="eyebrow">Simple y directo</p><h2>¿Cómo consultar?</h2></div>{[["1","Elegí tu muñeco","Explorá el catálogo y marcá el diseño que te interesa."],["2","Contanos tu consulta","Pedí precio, disponibilidad, colores o variantes."],["3","Coordinamos los datos","Patilu confirma posibilidades y forma de entrega o envío."]].map(([n,h,p],i) => <article class="step-card"><div class={`step-icon ${["step-pink","step-purple","step-green"][i]}`}>{n}</div><div><h3>{h}</h3><p>{p}</p></div></article>)}</div>
      </section>

      <section class="section story-section" id="sobre-patilu">
        <div class="container story-grid"><img class="story-image" src="/assets/artesana.webp" alt="Manos tejiendo una pieza al crochet" loading="lazy" /><div class="story-copy"><p class="eyebrow">El corazón de Patilu</p><h2>Muñecos creados con tiempo y dedicación</h2><p>Patilu es un proyecto artesanal hecho en Pinamar. Cada muñeco está tejido a mano con dedicación, cuidado por los detalles e intención de acompañar historias cotidianas.</p><p class="location-note">♡ Hecho a mano en Pinamar, Argentina.</p></div><div class="testimonials"><div class="section-heading compact"><h2>Principios de consulta <span aria-hidden="true">♡</span></h2></div><div class="testimonial-grid">{principles.map(([h,p]) => <blockquote><p>{p}</p><footer>{h}</footer></blockquote>)}</div></div></div>
      </section>

      <section class="section info-section">
        <div class="container info-grid"><div><p class="eyebrow">Coordinación</p><h2>Entregas y envíos a consultar</h2><div class="shipping-grid"><article><span aria-hidden="true">⌖</span><div><h3>Pinamar</h3><p>Coordinación a confirmar.</p></div></article><article><span aria-hidden="true">🚚</span><div><h3>Otras localidades</h3><p>Opciones a consultar.</p></div></article><article><span aria-hidden="true">📦</span><div><h3>Embalaje cuidado</h3><p>Preparación a confirmar.</p></div></article></div></div><div class="faq" id="preguntas"><p class="eyebrow">Antes de pedir</p><h2>Preguntas frecuentes</h2>{faqs.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></div>
      </section>
    </main>

    <footer class="site-footer" id="contacto"><div class="container footer-grid"><div><a class="brand footer-brand" href="#inicio"><svg class="brand-mark" viewBox="0 0 64 64" aria-hidden="true"><circle cx="27" cy="31" r="17" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M13 24c12 3 25 10 34 24M14 38c11-9 23-15 36-15M22 15c4 12 12 25 22 35M13 31c11-4 24-7 38-4M21 49c10-10 17-22 20-35" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg><span>Patilu</span></a><p>Muñecos tejidos al crochet hechos a mano en Pinamar.</p><small>♡ Hecho a mano en Pinamar, Argentina.</small></div><div><h3>Navegación</h3>{nav.slice(0,5).map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</div><div><h3>Ayuda</h3><a href="#preguntas">Preguntas frecuentes</a><a href="#contacto">Envíos y entregas a confirmar</a><a href="#contacto">Privacidad y términos próximamente</a></div><div><h3>Contacto</h3><p>Datos de contacto próximamente.</p><a href="#custom-form">Preparar consulta personalizada</a><a href="#munecos">Consultar catálogo</a></div></div></footer>
    <a class="floating-whatsapp" href="#contacto" aria-label="Ver datos de contacto de Patilu"><span>◉</span></a>

    <script is:inline>
      const menuButton = document.querySelector(".menu-toggle");
      const menu = document.querySelector(".main-nav");
      const closeMenu = () => { menu?.classList.remove("open"); menuButton?.setAttribute("aria-expanded", "false"); document.body.classList.remove("menu-open"); };
      menuButton?.addEventListener("click", () => { const open = !menu?.classList.contains("open"); menu?.classList.toggle("open", open); menuButton.setAttribute("aria-expanded", String(open)); document.body.classList.toggle("menu-open", open); });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeMenu(); });
      document.querySelectorAll(".main-nav a").forEach((link) => link.addEventListener("click", closeMenu));
      const sections = [...document.querySelectorAll("main section[id], header[id]")];
      const navLinks = [...document.querySelectorAll(".main-nav a")];
      const updateActiveLink = () => { let currentId = "inicio"; for (const section of sections) if (section.offsetTop <= window.scrollY + 130) currentId = section.id; navLinks.forEach((link) => link.classList.toggle("active", link.getAttribute("href") === `#${currentId}`)); };
      window.addEventListener("scroll", updateActiveLink, { passive: true }); updateActiveLink();
      document.querySelector("#custom-form")?.addEventListener("submit", (event) => { event.preventDefault(); const form = event.currentTarget; const status = form.querySelector(".form-status"); if (!form.checkValidity()) { form.reportValidity(); status.textContent = "Revisá los campos marcados: necesitamos tu nombre y una idea con al menos 12 caracteres."; return; } const name = new FormData(form).get("name"); status.textContent = `Gracias, ${String(name).trim()}. Tu consulta quedó preparada. Datos de contacto próximamente.`; form.reset(); });
    </script>
  </body>
</html>

<style>
  :root{--background:#fff9f2;--surface:#fffdf9;--primary:#e9a3ae;--primary-dark:#8e4e5b;--lavender:#cfc4e8;--text:#46383a;--muted:#78696c;--border:#e8dcdd;--footer:#49352e;--shadow:0 18px 45px rgba(70,56,58,.1);--shadow-sm:0 10px 24px rgba(70,56,58,.08);--container:1200px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--text);background:var(--background);font-family:"Nunito Sans",system-ui,sans-serif;line-height:1.55}body.menu-open{overflow:hidden}img{display:block;width:100%}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}button,a{-webkit-tap-highlight-color:transparent}h1,h2,.brand{font-family:"DM Serif Display",Georgia,serif;font-weight:400}h1,h2,h3,p{margin-top:0}h1{margin-bottom:20px;font-size:clamp(2.7rem,5vw,5rem);line-height:.98;letter-spacing:-.035em}h1 span,h2 span{color:var(--primary)}h2{margin-bottom:14px;font-size:clamp(2rem,3.2vw,3.25rem);line-height:1.05;letter-spacing:-.025em}h3{margin-bottom:8px;line-height:1.2}p{color:var(--muted)}:focus-visible{outline:3px solid #8e4e5b;outline-offset:4px}.container{width:min(calc(100% - 40px),var(--container));margin-inline:auto}.section{padding:88px 0}.eyebrow{margin-bottom:12px;color:var(--primary-dark);font-size:.78rem;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.skip-link{position:fixed;z-index:999;top:12px;left:12px;transform:translateY(-140%);padding:10px 14px;border-radius:10px;background:var(--text);color:#fff}.skip-link:focus{transform:translateY(0)}
  .site-header{position:sticky;z-index:100;top:0;border-bottom:1px solid rgba(232,220,221,.75);background:rgba(255,253,249,.92);backdrop-filter:blur(16px)}.nav-wrap{min-height:82px;display:flex;align-items:center;gap:28px}.brand{display:inline-flex;align-items:center;color:#de7e8e;font-size:2.35rem;white-space:nowrap}.brand-mark{width:44px;height:44px}.main-nav{display:flex;align-items:center;gap:26px;margin-left:auto;font-weight:700}.main-nav a{position:relative;padding:28px 0 24px}.main-nav a:after{position:absolute;right:0;bottom:18px;left:0;height:2px;border-radius:999px;background:var(--primary);content:"";transform:scaleX(0);transition:transform .2s ease}.main-nav a:hover:after,.main-nav a.active:after{transform:scaleX(1)}.menu-toggle{display:none;width:44px;height:44px;padding:10px;border:0;background:transparent}.menu-toggle span:not(.sr-only){display:block;height:2px;margin:6px 0;border-radius:2px;background:var(--text)}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}.button{min-height:48px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 20px;border:1px solid transparent;border-radius:14px;cursor:pointer;font-weight:800;text-align:center;transition:transform .2s ease,box-shadow .2s ease,background .2s ease}.button:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm)}.button-primary{background:linear-gradient(135deg,#eb8f9e,#df7184);color:#fff}.button-secondary{background:linear-gradient(135deg,#bea8d6,#9f83bc);color:#fff}.button-whatsapp{background:#7ca760;color:#fff}.button-outline{width:100%;min-height:42px;border-color:var(--primary);background:transparent;color:var(--primary-dark)}.text-link{color:#d56879;font-weight:800}
  .hero{position:relative;overflow:hidden;padding:62px 0 40px;background:radial-gradient(circle at 14% 20%,rgba(244,221,164,.24),transparent 26%),radial-gradient(circle at 85% 10%,rgba(207,196,232,.3),transparent 28%),linear-gradient(180deg,#fffdf9 0%,#fff8f0 100%)}.hero:before{position:absolute;width:260px;height:260px;right:-100px;bottom:-120px;border-radius:50%;background:rgba(185,206,181,.28);content:""}.hero-grid{display:grid;grid-template-columns:.88fr 1.12fr;align-items:center;gap:52px}.hero-text{max-width:630px;margin-bottom:28px;font-size:1.08rem}.hero-actions,.trust-list{display:flex;flex-wrap:wrap;gap:12px}.trust-list{gap:10px;margin:28px 0 0;padding:0;list-style:none}.trust-list li{display:flex;align-items:center;gap:8px;padding:10px 13px;border:1px solid var(--border);border-radius:13px;background:rgba(255,255,255,.72);box-shadow:0 5px 16px rgba(70,56,58,.04);font-size:.92rem;font-weight:700}.hero-visual{position:relative;min-height:520px;overflow:hidden;border-radius:38px;box-shadow:var(--shadow)}.hero-visual:after{position:absolute;inset:0;background:linear-gradient(to top,rgba(70,56,58,.08),transparent 42%);content:""}.hero-visual img{height:100%;min-height:520px;object-fit:cover;object-position:center}.hero-note{position:absolute;z-index:2;right:24px;bottom:24px;display:flex;flex-direction:column;padding:13px 16px;border:1px solid rgba(255,255,255,.7);border-radius:16px;background:rgba(255,253,249,.86);box-shadow:var(--shadow-sm);backdrop-filter:blur(10px)}.hero-note span{color:var(--muted);font-size:.86rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:28px;margin-bottom:32px}.section-heading.compact{margin-bottom:20px}
  .products-section,.buying-section,.info-section{background:var(--surface)}.product-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px}.product-card{overflow:hidden;border:1px solid var(--border);border-radius:20px;background:#fff;box-shadow:0 8px 24px rgba(70,56,58,.055);transition:transform .2s ease,box-shadow .2s ease}.product-card:hover{transform:translateY(-5px);box-shadow:var(--shadow-sm)}.product-image{position:relative;aspect-ratio:1/1.12;overflow:hidden;background:#f8eee6}.product-image img{height:100%;object-fit:cover;transition:transform .35s ease}.product-card:hover .product-image img{transform:scale(1.035)}.product-body{padding:15px}.product-body h3{min-height:38px;font-size:1rem}.price{margin-bottom:6px;color:#d26073;font-size:.95rem;font-weight:800}.stock{margin-bottom:14px;color:#6b5d60;font-size:.78rem;font-weight:800}.badge{display:inline-flex;align-items:center;width:max-content;padding:5px 9px;border-radius:999px;font-size:.68rem;font-weight:800}.product-image>.badge{position:absolute;z-index:2;top:10px;left:10px}.badge-pink{background:#e78596;color:#fff}.badge-green{background:#9fbe84;color:#27442b}.badge-lavender{background:#a78fc1;color:#fff}.trends-section{background:linear-gradient(180deg,#fff9f2 0%,#fffdf9 100%)}.trend-layout{display:grid;grid-template-columns:.72fr 2.28fr;gap:46px;align-items:center}.trend-intro p{max-width:300px}.trend-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.trend-card{display:grid;grid-template-columns:42% 58%;min-height:170px;overflow:hidden;border:1px solid var(--border);border-radius:20px;background:#fff;box-shadow:var(--shadow-sm)}.trend-card img{height:100%;object-fit:cover}.trend-card>div{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:16px}.trend-card h3{margin:11px 0 8px;font-size:1rem}.trend-card a{color:#d56879;font-size:.86rem;font-weight:800}
