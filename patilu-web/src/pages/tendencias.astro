---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { formatPrice, getPrimaryImage, getPublishedProducts, getTrendingProducts } from "../data/catalog";

const allProducts = await getPublishedProducts();
const trending = getTrendingProducts(allProducts);
---
<BaseLayout
  title="Tendencias en muñecos tejidos al crochet | Patilu"
  description="Ideas de temporada tejidas al crochet por Patilu, siempre sujetas a revisión antes de publicarse."
  activePath="/tendencias"
>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Tendencias" }]} />
  <section class="section trends-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Radar Patilu</p><h1>Tendencias</h1><p>Ideas de temporada para inspirar una consulta, siempre sujetas a revisión y posibilidad real de realización.</p></div></div>
      {trending.length > 0
        ? <div class="trend-grid">{trending.map((product) => { const primary = getPrimaryImage(product); return <article class="trend-card">{primary && <img src={primary.url} alt={primary.alt_text} loading="lazy" />}<div><span class="badge badge-lavender">Inspiración</span><h2>{product.title}</h2><p class="price">{formatPrice(product)}</p><a href={`/productos/${product.slug}/`}>Consultar idea →</a></div></article>})}</div>
        : <p class="empty-state">No hay tendencias publicadas por el momento. Muy pronto vas a poder consultar acá las últimas ideas de temporada.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .trends-section{background:var(--surface)}.trend-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.trend-card{display:grid;grid-template-columns:42% 58%;min-height:170px;overflow:hidden;border:1px solid var(--border);border-radius:20px;background:#fff;box-shadow:var(--shadow-sm)}.trend-card img{height:100%;object-fit:cover}.trend-card>div{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:16px}.trend-card h2{margin:11px 0 8px;font-size:1rem}.trend-card .price{margin:0 0 8px;font-size:.85rem;font-weight:800;color:#d26073}.trend-card a{color:#d56879;font-size:.86rem;font-weight:800}
  .badge{display:inline-flex;align-items:center;width:max-content;padding:5px 9px;border-radius:999px;font-size:.68rem;font-weight:800}.badge-lavender{background:#a78fc1;color:#fff}
  .empty-state{padding:40px 0;color:var(--muted)}
  @media (max-width:900px){.trend-grid{grid-template-columns:1fr 1fr}}
  @media (max-width:680px){.trend-grid{grid-template-columns:1fr}.trend-card{min-height:150px}}
</style>
