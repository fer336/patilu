---
import PurchaseModal from "../../components/PurchaseModal.astro";
import { AVAILABILITY_LABELS, formatPrice, getPrimaryImage, getPublishedProduct } from "../../data/catalog";
import { getProductWhatsappUrl } from "../../data/products";

const product = await getPublishedProduct(Astro.params.slug ?? "");
if (!product) return new Response("Producto no encontrado", { status: 404 });
const primary = getPrimaryImage(product);
const thumbnails = product.images.filter((image) => !image.is_primary).sort((a, b) => a.position - b.position);
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{product.title} | Patilu</title><meta name="description" content={product.description} /><meta name="theme-color" content="#fff9f2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header"><div class="container nav-wrap"><a class="brand" href="/" aria-label="Patilu, volver al inicio"><span class="brand-mark" aria-hidden="true">P</span><span>Patilu</span></a><a class="text-link" href="/#munecos">Volver al catálogo</a></div></header>
    <main id="contenido"><section class="product-page"><div class="container product-layout">
      <div class="gallery" aria-label={`Imágenes de ${product.title}`}>
        <div class="main-image">{primary ? <img id="product-main-image" src={primary.url} alt={primary.alt_text} /> : <div class="image-placeholder">Foto próximamente</div>}</div>
        {thumbnails.length > 0 && <div class="thumb-grid" aria-label="Galería de detalles">
          {thumbnails.map((image) => <button type="button" class="thumbnail" data-gallery-image={image.url} data-gallery-alt={image.alt_text} aria-label={`Ver ${image.alt_text}`} aria-pressed="false"><img src={image.url} alt="" loading="lazy" /></button>)}
        </div>}
      </div>
      <article class="product-info"><p class="eyebrow">Pieza artesanal</p><h1>{product.title}</h1><p class="lead">{product.description}</p><dl class="facts"><div><dt>Medida</dt><dd>{product.measure}</dd></div><div><dt>Disponibilidad</dt><dd>{AVAILABILITY_LABELS[product.availability]}</dd></div><div><dt>Precio</dt><dd>{formatPrice(product)}</dd></div></dl></article>
      <aside class="purchase-card" aria-label="Opciones para consultar o comprar"><p class="card-label">Compra sin checkout online</p><h2>Coordiná este producto</h2><p>Podés dejar tus datos para avanzar después o consultar por WhatsApp antes de decidir.</p><button class="button button-primary" type="button" data-buy-button data-product={product.title}>Comprar</button><a class="button button-outline" href={getProductWhatsappUrl({ name: product.title })} target="_blank" rel="noopener noreferrer">Consultar por WhatsApp</a><div class="notes"><strong>Importante</strong><span>No hay pago automático. Patilu confirma precio, disponibilidad y coordinación antes de avanzar.</span></div></aside>
    </div></section></main>
    <PurchaseModal id="product-purchase-modal" />
    <script is:inline>
      const mainImage = document.querySelector("#product-main-image");
      const thumbnails = document.querySelectorAll("[data-gallery-image]");
      thumbnails.forEach((button) => button.addEventListener("click", () => {
        if (!(mainImage instanceof HTMLImageElement) || !(button instanceof HTMLElement)) return;
        mainImage.src = button.dataset.galleryImage || mainImage.src;
        mainImage.alt = button.dataset.galleryAlt || "Imagen del producto";
        thumbnails.forEach((candidate) => candidate.setAttribute("aria-pressed", String(candidate === button)));
      }));
    </script>
  </body>
</html>
<style>
  :root{--surface:#fffdf9;--primary:#df7184;--primary-dark:#8e4e5b;--text:#46383a;--muted:#78696c;--border:#e8dcdd;--shadow:0 18px 45px rgba(70,56,58,.1);--container:1160px}*{box-sizing:border-box}body{margin:0;color:var(--text);background:#fff9f2;font-family:"Nunito Sans",system-ui,sans-serif;line-height:1.55}img{display:block;width:100%}a{color:inherit;text-decoration:none}button{font:inherit}h1,h2,.brand{font-family:"DM Serif Display",Georgia,serif;font-weight:400}h1,h2,p{margin-top:0}h1{margin-bottom:18px;font-size:clamp(2.6rem,5vw,4.6rem);line-height:.98;letter-spacing:-.035em}h2{margin-bottom:10px;font-size:2rem;line-height:1.05}:focus-visible{outline:3px solid var(--primary-dark);outline-offset:4px}.container{width:min(calc(100% - 40px),var(--container));margin-inline:auto}.skip-link{position:fixed;z-index:999;top:12px;left:12px;transform:translateY(-140%);padding:10px 14px;border-radius:10px;background:var(--text);color:#fff}.skip-link:focus{transform:translateY(0)}.site-header{border-bottom:1px solid var(--border);background:var(--surface)}.nav-wrap{min-height:78px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:inline-flex;align-items:center;gap:10px;color:#de7e8e;font-size:2.2rem}.brand-mark{width:42px;height:42px;display:grid;place-items:center;border:1px solid currentColor;border-radius:50%;font-size:1.55rem}.text-link{color:#d56879;font-weight:900}.product-page{padding:42px 0 90px}.product-layout{display:grid;grid-template-columns:minmax(280px,.9fr) minmax(280px,1fr) 340px;gap:34px;align-items:start}.main-image{width:min(100%,410px);aspect-ratio:4/5;display:grid;place-items:center;overflow:hidden;border:1px solid var(--border);border-radius:26px;background:#f8eee6;box-shadow:var(--shadow)}.main-image img{height:100%;object-fit:contain}.image-placeholder{color:var(--muted)}.thumb-grid{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}.thumbnail{width:68px;height:68px;padding:3px;border:1px solid var(--border);border-radius:10px;background:#fff;cursor:pointer}.thumbnail[aria-pressed="true"]{border:2px solid var(--primary-dark)}.thumbnail img{height:100%;border-radius:6px;object-fit:contain}.product-info{padding-top:8px}.eyebrow,.card-label{margin-bottom:10px;color:var(--primary-dark);font-size:.75rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.lead{max-width:58ch;color:var(--muted);font-size:1.05rem}.facts{margin-top:32px;border-top:1px solid var(--border)}.facts div{display:grid;grid-template-columns:130px 1fr;gap:20px;padding:15px 0;border-bottom:1px solid var(--border)}.facts dt{color:var(--muted);font-size:.8rem;font-weight:800}.facts dd{margin:0;font-weight:800}.purchase-card{position:sticky;top:22px;padding:24px;border:1px solid var(--border);border-radius:22px;background:#fff;box-shadow:var(--shadow)}.purchase-card>p:not(.card-label){color:var(--muted)}.button{min-height:48px;display:flex;align-items:center;justify-content:center;margin-top:10px;padding:12px 18px;border:1px solid transparent;border-radius:13px;cursor:pointer;font-weight:900;text-align:center}.button-primary{background:var(--primary);color:#fff}.button-outline{border-color:var(--primary);color:var(--primary-dark)}.notes{display:flex;flex-direction:column;gap:4px;margin-top:20px;padding-top:18px;border-top:1px solid var(--border)}.notes span{color:var(--muted);font-size:.8rem}@media(max-width:1000px){.product-layout{grid-template-columns:1fr 1fr}.purchase-card{position:static;grid-column:1/-1}}@media(max-width:680px){.container{width:min(calc(100% - 28px),var(--container))}.product-page{padding-top:24px}.product-layout{grid-template-columns:1fr;gap:26px}.main-image{width:min(100%,340px);justify-self:center}.purchase-card{grid-column:auto}.facts div{grid-template-columns:105px 1fr}}
</style>
